# Finora — muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env — so'ng qiymatlarni o'zingizga moslang.
# Bu fayl hech qachon haqiqiy sirlar bilan commit qilinmaydi (.env .gitignore'da).

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Ma'lumotlar bazasi (SQLite fayl yo'li) ---
DATABASE_PATH=./server/data/finora.db

# --- Sessiya / cookie ---
# Sessiya necha kundan keyin tugashi.
SESSION_TTL_DAYS=30
# Ishlab chiqarishda (NODE_ENV=production) avtomatik "true" bo'ladi — cookie faqat HTTPS orqali
# yuboriladi. Lokal http://localhost ishlab chiqishda buni qo'lda "true" qilmang.
COOKIE_SECURE=false

# --- Tezlik cheklovi (login/registratsiya uchun, PHASE 9) ---
# Bitta IP+email necha millisekund oynada necha marta urinishi mumkin.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# --- Valyuta kursi (ixtiyoriy ikkilamchi provayder) ---
# Asosiy manba CBU (Markaziy bank) ochiq APIsi — kalit talab qilmaydi. Bu faqat zaxira provayder
# uchun, agar undan foydalanilsa.
EXCHANGE_SECONDARY_API_KEY=

# --- Admin paneli (faqat SERVER tomonida; klientga hech qachon chiqmaydi) ---
# Birinchi ishga tushirishda adminlar jadvali boʻsh boʻlsa, shu qiymatlardan bitta admin yaratiladi
# va parol xeshlanib saqlanadi. Admin yaratilgach bu qiymatlarni .env dan OʻCHIRIB tashlang.
# DIQQAT: quyidagi "7000" paroli FAQAT lokal ishlab chiqish uchun. Admin yaratilgach bu qiymat
# ahamiyatsiz; NODE_ENV=production da 12 belgidan qisqa parol bilan admin yaratilmaydi, va birinchi
# kirishdan keyin parolni almashtirish MAJBURIY.
ADMIN_BOOTSTRAP_USERNAME=uchqun
ADMIN_BOOTSTRAP_PASSWORD=7000
ADMIN_SESSION_TTL_HOURS=8
ADMIN_IDLE_TIMEOUT_MINUTES=60
